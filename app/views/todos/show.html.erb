<% content_for :title, @todo.title %>

<div class="mx-auto max-w-3xl px-4 py-10">
  <% if notice.present? %>
    <p class="mb-6 rounded bg-green-50 px-4 py-3 text-green-700"><%= notice %></p>
  <% end %>

  <%= render @todo %>

  <div class="mt-6 flex gap-3">
    <%= link_to "Edit this todo", edit_todo_path(@todo), class: "rounded border border-slate-300 px-4 py-2 font-medium text-slate-700 hover:bg-slate-50" %>
    <%= link_to "Back to todos", todos_path, class: "rounded border border-slate-300 px-4 py-2 font-medium text-slate-700 hover:bg-slate-50" %>
    <%= button_to "Destroy this todo", @todo, method: :delete, class: "rounded border border-red-200 px-4 py-2 font-medium text-red-700 hover:bg-red-50" %>
  </div>
</div>
