<% content_for :title, "Editing todo" %>

<div class="mx-auto max-w-xl px-4 py-10">
  <h1 class="mb-6 text-3xl font-bold text-slate-900">Editing todo</h1>

  <%= render "form", todo: @todo %>

  <div class="mt-6 flex gap-3">
    <%= link_to "Show this todo", @todo, class: "text-slate-600 hover:text-slate-900" %>
    <%= link_to "Back to todos", todos_path, class: "text-slate-600 hover:text-slate-900" %>
  </div>
</div>
