<div id="<%= dom_id todo %>" class="rounded border border-slate-200 bg-white p-4 shadow-sm">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-lg font-semibold text-slate-900"><%= todo.title %></h2>
      <span class="mt-2 inline-flex rounded-full px-3 py-1 text-sm font-medium <%= todo.status == "done" ? "bg-green-100 text-green-700" : "bg-amber-100 text-amber-700" %>">
        <%= todo.status.humanize %>
      </span>
    </div>

    <div class="flex gap-2">
      <%= link_to "Show", todo, class: "rounded border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
      <%= link_to "Edit", edit_todo_path(todo), class: "rounded border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
      <%= button_to "Delete", todo, method: :delete, class: "rounded border border-red-200 px-3 py-2 text-sm font-medium text-red-700 hover:bg-red-50" %>
    </div>
  </div>
</div>
